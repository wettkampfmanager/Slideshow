[Unit]
Description=Slideshow Server (Admin-Oberfläche und Player)
After=network.target time-sync.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
Environment=SLIDESHOW_DATA=@APP_DIR@/data
ExecStart=@APP_DIR@/.venv/bin/uvicorn --factory slideshow.app:create_app --host 0.0.0.0 --port @PORT@
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
